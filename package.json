{
  "name": "api-reservas-k6",
  "version": "1.0.0",
  "description": "API de reservas con PostgreSQL para pruebas de carga y estrés con k6",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": { "node": ">=20" },
  "scripts": {
